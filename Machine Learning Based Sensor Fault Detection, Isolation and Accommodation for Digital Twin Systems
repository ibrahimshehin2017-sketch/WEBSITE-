        "\n",
        "# STEP 2: FAULT INJECTION FUNCTION\n",
        "\n",
        "def inject_sensor_faults(data, fault_rate=0.10, random_state=42):\n",
        "\n",
        "    rng = np.random.default_rng(random_state)\n",
        "\n",
        "    faulty_data = data.copy()\n",
        "\n",
        "    # 0 = Healthy, 1 = Bias, 2 = Drift,\n",
        "    # 3 = Noise, 4 = Freeze\n",
        "\n",
        "    labels = pd.DataFrame(\n",
        "        0,\n",
        "        index=data.index,\n",
        "        columns=data.columns\n",
        "    )\n",
        "\n",
        "    n_samples = len(data)\n",
        "\n",
        "    for sensor in data.columns:\n",
        "\n",
        "        # Number of samples to be affected\n",
        "        n_faults = int(n_samples * fault_rate)\n",
        "\n",
        "        # Select fault locations\n",
        "        fault_indices = rng.choice(\n",
        "            n_samples,\n",
        "            size=n_faults,\n",
        "            replace=False\n",
        "        )\n",
        "\n",
        "        rng.shuffle(fault_indices)\n",
        "\n",
        "        # Divide selected samples among four fault types\n",
        "        groups = np.array_split(fault_indices, 4)\n",
        "\n",
        "        # --------------------------------\n",
        "        # 1. BIAS FAULT\n",
        "        # --------------------------------\n",
        "\n",
        "        bias_indices = groups[0]\n",
        "\n",
        "        bias_value = rng.uniform(0.2, 0.4)\n",
        "\n",
        "        bias_sign = rng.choice([-1, 1])\n",
        "\n",
        "        faulty_data.loc[bias_indices, sensor] += (\n",
        "            bias_sign * bias_value\n",
        "        )\n",
        "\n",
        "        labels.loc[bias_indices, sensor] = 1\n",
        "\n",
        "        # --------------------------------\n",
        "        # 2. DRIFT FAULT\n",
        "        # --------------------------------\n",
        "\n",
        "        drift_indices = groups[1]\n",
        "\n",
        "        drift_indices = np.sort(drift_indices)\n",
        "\n",
        "        drift_value = rng.uniform(0.2, 0.4)\n",
        "\n",
        "        if len(drift_indices) > 0:\n",
        "\n",
        "            drift_values = np.linspace(\n",
        "                0,\n",
        "                drift_value,\n",
        "                len(drift_indices)\n",
        "            )\n",
        "\n",
        "            faulty_data.loc[\n",
        "                drift_indices, sensor\n",
        "            ] += drift_values\n",
        "\n",
        "        labels.loc[drift_indices, sensor] = 2\n",
        "\n",
        "        # --------------------------------\n",
        "        # 3. NOISE FAULT\n",
        "        # --------------------------------\n",
        "\n",
        "        noise_indices = groups[2]\n",
        "\n",
        "        noise_variance = rng.uniform(0.2, 0.4)\n",
        "\n",
        "        noise = rng.normal(\n",
        "            0,\n",
        "            np.sqrt(noise_variance),\n",
        "            len(noise_indices)\n",
        "        )\n",
        "\n",
        "        faulty_data.loc[\n",
        "            noise_indices, sensor\n",
        "        ] += noise\n",
        "\n",
        "        labels.loc[noise_indices, sensor] = 3\n",
        "\n",
        "        # --------------------------------\n",
        "        # 4. FREEZE FAULT\n",
        "        # --------------------------------\n",
        "\n",
        "        freeze_indices = groups[3]\n",
        "\n",
        "        if len(freeze_indices) > 0:\n",
        "\n",
        "            freeze_value = data[sensor].iloc[\n",
        "                max(0, int(freeze_indices.min()) - 1)\n",
        "            ]\n",
        "\n",
        "            faulty_data.loc[\n",
        "                freeze_indices, sensor\n",
        "            ] = freeze_value\n",
        "\n",
        "        labels.loc[freeze_indices, sensor] = 4\n",
        "\n",
        "    return faulty_data, labels\n",
        "\n",
        "\n",
        "print(\"Fault injection function created!\")\n"
      ],
