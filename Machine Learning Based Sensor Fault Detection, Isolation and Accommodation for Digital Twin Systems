        "\n",
        "# MLP TEMPORAL PREDICTOR\n",
        "\n",
        "WINDOW_SIZE = 10\n",
        "\n",
        "def create_sequences(values, window=10):\n",
        "\n",
        "    X, y = [], []\n",
        "\n",
        "    for i in range(window, len(values)):\n",
        "\n",
        "        X.append(values[i-window:i])\n",
        "        y.append(values[i])\n",
        "\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "\n",
        "def create_predictor():\n",
        "\n",
        "    model = Sequential([\n",
        "        Input(shape=(WINDOW_SIZE,)),\n",
        "        Dense(32, activation='relu'),\n",
        "        Dense(16, activation='relu'),\n",
        "        Dense(8, activation='relu'),\n",
        "        Dense(1)\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer='adam',\n",
        "        loss='mse',\n",
        "        metrics=['mae']\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "\n",
        "print(\"MLP predictor architecture created!\")\n"
      ],
