        "\n",
        "from sklearn.metrics import mean_absolute_error\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "results = []\n",
        "\n",
        "for sensor in sensor_columns:\n",
        "\n",
        "    actual = healthy_test_reference[sensor].values\n",
        "    faulty = faulty_test[sensor].values\n",
        "    corrected = accommodated_data[sensor].values\n",
        "\n",
        "    mae_before = mean_absolute_error(actual, faulty)\n",
        "    mae_after = mean_absolute_error(actual, corrected)\n",
        "\n",
        "    rmse_before = np.sqrt(\n",
        "        mean_squared_error(actual, faulty)\n",
        "    )\n",
        "\n",
        "    rmse_after = np.sqrt(\n",
        "        mean_squared_error(actual, corrected)\n",
        "    )\n",
        "\n",
        "    results.append({\n",
        "        \"Sensor\": sensor,\n",
        "        \"MAE Before\": mae_before,\n",
        "        \"MAE After\": mae_after,\n",
        "        \"RMSE Before\": rmse_before,\n",
        "        \"RMSE After\": rmse_after\n",
        "    })\n",
        "\n",
        "evaluation_df = pd.DataFrame(results)\n",
        "\n",
        "display(evaluation_df)\n"
      ],
