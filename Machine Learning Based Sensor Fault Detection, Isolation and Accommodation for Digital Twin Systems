      "source": [
        "\n",
        "# GENERATE SYNTHETIC SENSOR DATA\n",
        "\n",
        "n_samples = 10000\n",
        "\n",
        "time = np.arange(n_samples)\n",
        "\n",
        "# Temperature variation\n",
        "temperature = (\n",
        "    27\n",
        "    + 3 * np.sin(2 * np.pi * time / 1000)\n",
        "    + np.random.normal(0, 0.3, n_samples)\n",
        ")\n",
        "\n",
        "# Humidity variation\n",
        "humidity = (\n",
        "    65\n",
        "    - 0.8 * (temperature - 27)\n",
        "    + 5 * np.sin(2 * np.pi * time / 1500)\n",
        "    + np.random.normal(0, 1, n_samples)\n",
        ")\n",
        "\n",
        "# Atmospheric pressure variation\n",
        "pressure = (\n",
        "    1008\n",
        "    + 3 * np.sin(2 * np.pi * time / 2000)\n",
        "    + np.random.normal(0, 0.4, n_samples)\n",
        ")\n",
        "\n",
        "# Create dataset\n",
        "df = pd.DataFrame({\n",
        "    \"Time\": time,\n",
        "    \"Temperature\": temperature,\n",
        "    \"Humidity\": humidity,\n",
        "    \"Pressure\": pressure\n",
        "})\n",
        "\n",
        "print(\"Synthetic sensor dataset generated!\")\n",
        "\n",
        "display(df.head())\n",
        "\n",
        "print(\"\\nDataset shape:\", df.shape)\n"
      ]
