        "\n",
        "accommodated_data = faulty_test.copy()\n",
        "\n",
        "accommodation_status = pd.DataFrame(\n",
        "    index=faulty_test.index\n",
        ")\n",
        "\n",
        "for sensor in sensor_columns:\n",
        "\n",
        "    other_sensors = [\n",
        "        col for col in sensor_columns\n",
        "        if col != sensor\n",
        "    ]\n",
        "\n",
        "    sensor_faulty = fault_predictions[sensor] != 0\n",
        "\n",
        "    other_sensors_healthy = (\n",
        "        (fault_predictions[other_sensors[0]] == 0) &\n",
        "        (fault_predictions[other_sensors[1]] == 0)\n",
        "    )\n",
        "\n",
        "    replace_mask = sensor_faulty & other_sensors_healthy\n",
        "\n",
        "    accommodated_data.loc[\n",
        "        replace_mask, sensor\n",
        "    ] = estimated_sensor_data.loc[\n",
        "        replace_mask, sensor\n",
        "    ]\n",
        "\n",
        "    accommodation_status[sensor] = np.where(\n",
        "        replace_mask,\n",
        "        \"Replaced with MLP estimate\",\n",
        "        np.where(\n",
        "            sensor_faulty,\n",
        "            \"Fault detected - not corrected\",\n",
        "            \"Original reading retained\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "print(\"Fault Accommodation Completed!\")\n",
        "\n",
        "display(accommodated_data.head())\n",
        "display(accommodation_status.head())\n"
