        "\n",
        "# MULTI-TASK MLP CLASSIFIER\n",
        "\n",
        "from tensorflow.keras.layers import Input, Dense, Dropout\n",
        "from tensorflow.keras.models import Model\n",
        "\n",
        "# Input layer\n",
        "inputs = Input(shape=(6,), name=\"residual_input\")\n",
        "\n",
        "# Shared hidden layers\n",
        "x = Dense(64, activation=\"relu\")(inputs)\n",
        "x = Dropout(0.2)(x)\n",
        "\n",
        "x = Dense(32, activation=\"relu\")(x)\n",
        "x = Dense(16, activation=\"relu\")(x)\n",
        "\n",
        "# Three output heads\n",
        "temperature_output = Dense(\n",
        "    5,\n",
        "    activation=\"softmax\",\n",
        "    name=\"Temperature_fault\"\n",
        ")(x)\n",
        "\n",
        "humidity_output = Dense(\n",
        "    5,\n",
        "    activation=\"softmax\",\n",
        "    name=\"Humidity_fault\"\n",
        ")(x)\n",
        "\n",
        "pressure_output = Dense(\n",
        "    5,\n",
        "    activation=\"softmax\",\n",
        "    name=\"Pressure_fault\"\n",
        ")(x)\n",
        "\n",
        "# Build model\n",
        "classifier = Model(\n",
        "    inputs=inputs,\n",
        "    outputs={\n",
        "        \"Temperature_fault\": temperature_output,\n",
        "        \"Humidity_fault\": humidity_output,\n",
        "        \"Pressure_fault\": pressure_output\n",
        "    }\n",
        ")\n",
        "\n",
        "# Compile model\n",
