        "\n",
        "# SQUARED RESIDUAL CALCULATION\n",
        "\n",
        "# Use faulty sensor data\n",
        "faulty_input = faulty_10.copy()\n",
        "\n",
        "residual_features = pd.DataFrame(index=faulty_input.index)\n",
        "\n",
        "for sensor in sensor_columns:\n",
        "\n",
        "    other_sensors = [\n",
        "        col for col in sensor_columns\n",
        "        if col != sensor\n",
        "    ]\n",
        "\n",
        "    # -------------------------------\n",
        "    # 1. ESTIMATOR RESIDUAL\n",
        "    # -------------------------------\n",
        "\n",
        "    estimated_values = estimators[sensor].predict(\n",
        "        faulty_input[other_sensors],\n",
        "        verbose=0\n",
        "    ).flatten()\n",
        "\n",
        "    actual_values = faulty_input[sensor].values\n",
        "\n",
        "    estimator_residual = (\n",
        "        actual_values - estimated_values\n",
        "    ) ** 2\n",
        "\n",
        "    residual_features[\n",
        "        sensor + \"_Estimator_Residual\"\n",
        "    ] = estimator_residual\n",
        "\n",
        "    # -------------------------------\n",
        "    # 2. PREDICTOR RESIDUAL\n",
        "    # -------------------------------\n",
        "\n",
        "    sensor_values = faulty_input[sensor].values\n",
        "\n",
        "    X_seq, y_seq = create_sequences(\n",
        "        sensor_values,\n",
        "        WINDOW_SIZE\n",
        "    )\n",
        "\n",
        "    predicted_values = predictors[sensor].predict(\n",
        "        X_seq,\n",
        "        verbose=0\n",
        "    ).flatten()\n",
        "\n",
        "    predictor_residual = (\n",
        "        y_seq - predicted_values\n",
        "    ) ** 2\n",
        "\n",
        "    # First 10 samples have no previous window\n",
        "    residual_features[\n",
        "        sensor + \"_Predictor_Residual\"\n",
        "    ] = np.nan\n",
        "\n",
        "    residual_features.loc[\n",
        "        WINDOW_SIZE:,\n",
        "        sensor + \"_Predictor_Residual\"\n",
        "    ] = predictor_residual\n",
        "\n",
        "\n",
        "# Remove initial samples without predictor residuals\n",
        "residual_features = residual_features.iloc[\n",
        "    WINDOW_SIZE:\n",
        "].reset_index(drop=True)\n",
        "\n",
        "print(\"Squared residuals calculated successfully!\")\n",
        "\n",
