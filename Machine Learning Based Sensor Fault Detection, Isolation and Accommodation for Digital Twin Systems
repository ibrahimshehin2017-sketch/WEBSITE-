      "source": [
        "\n",
        "# TRAIN THREE MLP ESTIMATORS\n",
        "\n",
        "estimators = {}\n",
        "\n",
        "for sensor in sensor_columns:\n",
        "\n",
        "    other_sensors = [\n",
        "        col for col in sensor_columns\n",
        "        if col != sensor\n",
        "    ]\n",
        "\n",
        "    model = create_estimator()\n",
        "\n",
        "    print(\"\\nTraining estimator for:\", sensor)\n",
        "\n",
        "    history = model.fit(\n",
        "        healthy_train[other_sensors],\n",
        "        healthy_train[sensor],\n",
        "        validation_data=(\n",
        "            healthy_val[other_sensors],\n",
        "            healthy_val[sensor]\n",
        "        ),\n",
        "        epochs=25,\n",
        "        batch_size=64,\n",
        "        callbacks=[\n",
        "            EarlyStopping(\n",
        "                monitor='val_loss',\n",
