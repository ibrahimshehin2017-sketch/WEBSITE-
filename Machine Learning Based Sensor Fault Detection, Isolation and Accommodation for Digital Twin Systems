        "# HANDLE CLASS IMBALANCE\n",
        "\n",
        "def calculate_sample_weights(label_data):\n",
        "\n",
        "    weights = {}\n",
        "\n",
        "    for sensor in sensor_columns:\n",
        "\n",
        "        labels = label_data[sensor].values\n",
        "\n",
        "        counts = np.bincount(\n",
        "            labels,\n",
        "            minlength=NUM_CLASSES\n",
        "        )\n",
        "\n",
        "        class_weights = np.zeros(NUM_CLASSES)\n",
        "\n",
        "        present = counts > 0\n",
        "\n",
        "        class_weights[present] = (\n",
        "            len(labels) /\n",
        "            (NUM_CLASSES * counts[present])\n",
        "        )\n",
        "\n",
        "        weights[sensor + \"_fault\"] = (\n",
        "            class_weights[labels]\n",
        "        )\n",
        "\n",
        "    return weights\n",
        "\n",
